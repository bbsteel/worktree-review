{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worktree-review.dev/schemas/cli-result.v1.json",
  "title": "Worktree Review CLI result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate_state",
    "attempt_id",
    "request_key",
    "source_repository",
    "target_ref",
    "target_head_oid",
    "proposed_ref",
    "proposed_source",
    "proposed_head_oid",
    "merge_tree_oid",
    "review_policy_version",
    "compute_policy_version",
    "compute_policy_disclosure",
    "stage_outcomes",
    "dimension_outcomes",
    "findings",
    "draft_findings",
    "coverage",
    "usage",
    "summary"
  ],
  "properties": {
    "schema": { "const": "worktree-review.cli.result/v1" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "request_key": { "$ref": "#/$defs/requestKey" },
    "review_identity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["merge_tree_oid", "review_policy_version"],
      "properties": {
        "merge_tree_oid": { "type": "string" },
        "review_policy_version": { "$ref": "#/$defs/policyVersion" }
      }
    },
    "gate_state": {
      "type": "string",
      "enum": [
        "Awaiting review",
        "In progress",
        "Passed",
        "Passed with bypass",
        "Blocked",
        "Error"
      ]
    },
    "source_repository": { "type": "string" },
    "target_ref": { "type": "string" },
    "target_head_oid": { "type": "string" },
    "proposed_ref": { "type": "string" },
    "proposed_source": {
      "type": "string",
      "enum": ["committed-ref", "current-worktree-snapshot"]
    },
    "proposed_head_oid": { "type": "string" },
    "merge_tree_oid": { "type": ["string", "null"] },
    "review_policy_version": { "$ref": "#/$defs/policyVersion" },
    "compute_policy_version": { "$ref": "#/$defs/policyVersion" },
    "compute_policy_disclosure": { "$ref": "#/$defs/computePolicyDisclosure" },
    "stage_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageOutcome" }
    },
    "dimension_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimensionOutcome" }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "draft_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "usage": { "type": "array", "items": { "$ref": "#/$defs/usageRecord" } },
    "call_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["call_count", "estimated_input_tokens", "max_output_tokens_per_call"],
      "properties": {
        "call_count": { "type": "integer", "minimum": 0 },
        "estimated_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "max_output_tokens_per_call": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": { "type": "string" },
    "error_detail": { "type": ["string", "null"] }
  },
  "$defs": {
    "requestKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "target_ref",
        "target_head_oid",
        "proposed_head_oid",
        "review_policy_version"
      ],
      "properties": {
        "source_repository": { "type": "string" },
        "target_ref": { "type": "string" },
        "target_head_oid": { "type": "string" },
        "proposed_head_oid": { "type": "string" },
        "review_policy_version": { "$ref": "#/$defs/policyVersion" }
      }
    },
    "usageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "model"],
      "properties": {
        "kind": { "type": "string", "enum": ["measured", "declared", "estimated"] },
        "input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "cost_usd": { "type": ["number", "string", "null"] },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "note": { "type": ["string", "null"] }
      }
    },
    "policyVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semver", "sha256"],
      "properties": {
        "semver": { "type": "string" },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "computePolicyDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "data_destination", "known_retention"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "data_destination": { "type": "string", "minLength": 1 },
        "known_retention": { "type": "string", "minLength": 1 },
        "provider_configuration_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stageOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status"],
      "properties": {
        "stage": {
          "type": "string",
          "$comment": "Pre-Alpha in-place identifiers. Review Worktree preparation is prepare-review-worktree (renamed from prepare-workspace)."
        },
        "status": { "type": "string", "enum": ["completed", "failed", "not-started"] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "dimensionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id", "status"],
      "properties": {
        "dimension_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["completed", "failed", "not-started"] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "quoted_text",
        "context_class",
        "source",
        "snapshot_identity",
        "change_kind"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "quoted_text": { "type": "string" },
        "context_class": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["review-worktree", "target-tree", "merge-diff", "metadata"]
        },
        "snapshot_identity": { "type": ["string", "null"] },
        "change_kind": {
          "type": ["string", "null"],
          "enum": ["added", "modified", "deleted", null]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "severity",
        "evidence_band",
        "problem_statement",
        "expected_impact",
        "evidence_spans",
        "repair_guidance",
        "bypass_applied",
        "dimension_id"
      ],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor", "suggestion"]
        },
        "evidence_band": {
          "type": "string",
          "enum": ["insufficient", "supported", "verified"]
        },
        "problem_statement": { "type": "string", "minLength": 1 },
        "expected_impact": { "type": "string", "minLength": 1 },
        "evidence_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceSpan" }
        },
        "repair_guidance": { "type": ["string", "null"] },
        "bypass_applied": { "type": "boolean" },
        "dimension_id": { "type": ["string", "null"] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_coverage_complete"],
      "properties": {
        "required_coverage_complete": { "type": "boolean" },
        "mandatory_missing": { "type": "array", "items": { "type": "string" } },
        "optional_missing": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "unreviewable": { "type": "array", "items": { "type": "string" } },
        "reviewed": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
