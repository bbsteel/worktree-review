{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worktree-review.dev/schemas/user-config.v1.json",
  "title": "Worktree Review user configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "schema": { "const": "worktree-review.config/v1" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "provider": {
      "type": "string",
      "enum": ["anthropic", "openai", "local-cli"]
    },
    "url": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "minLength": 1 },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "model": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "properties": {
        "provider": { "enum": ["anthropic", "openai"] }
      },
      "required": ["key"],
      "not": { "required": ["command"] }
    },
    {
      "properties": {
        "provider": { "const": "local-cli" }
      },
      "required": ["command"],
      "not": { "anyOf": [{ "required": ["url"] }, { "required": ["key"] }] }
    }
  ]
}
