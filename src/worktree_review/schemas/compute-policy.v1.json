{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worktree-review.dev/schemas/compute-policy.v1.json",
  "title": "Worktree Review Compute Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "provider",
    "model",
    "max_budget_usd",
    "data_destination",
    "known_retention"
  ],
  "properties": {
    "schema": { "const": "worktree-review.compute-policy/v1" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "provider": { "type": "string", "enum": ["anthropic", "openai"] },
    "model": { "type": "string", "minLength": 1 },
    "max_output_tokens_per_call": { "type": "integer", "minimum": 1 },
    "max_budget_usd": { "type": "number", "minimum": 0 },
    "allow_start_under_uncertain_price": { "type": "boolean" },
    "permit_remote_transmission": { "type": "boolean" },
    "input_usd_per_million_tokens": { "type": "number", "minimum": 0 },
    "output_usd_per_million_tokens": { "type": "number", "minimum": 0 },
    "provider_configuration_fingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_destination": { "type": "string", "minLength": 1 },
    "known_retention": { "type": "string", "minLength": 1 }
  }
}
