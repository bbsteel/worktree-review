{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergegate.dev/schemas/review-policy.v1.json",
  "title": "MergeGate Review Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "required_dimensions"],
  "properties": {
    "schema": { "const": "mergegate.review-policy/v1" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "required_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "blocking_severities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["critical", "major", "minor", "suggestion"] },
      "uniqueItems": true
    },
    "minimum_blocking_evidence_band": {
      "type": "string",
      "enum": ["insufficient", "supported", "verified"]
    }
  }
}
